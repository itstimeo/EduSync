# Application
APP_NAME=EduSync
APP_ENV=production
APP_URL=http://localhost:8080

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edusync
DB_USER=root
DB_PASS=

# Session / Remember me
REMEMBER_INACTIVE_DAYS=14
REMEMBER_MAX_DAYS=60

# Mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=your@gmail.com
MAIL_FROM_NAME=EduSync

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/planning/google/callback

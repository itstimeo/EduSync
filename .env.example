# Application
APP_NAME=EduSync
APP_ENV=development
APP_URL=http://localhost/edusync/public

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edusync
DB_USER=root
DB_PASS=

# Remember me
REMEMBER_INACTIVE_DAYS=14
REMEMBER_MAX_DAYS=60

# Mail (Gmail SMTP)
# Gmail: Settings > Security > 2-Step Verification > App passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME=EduSync
MAIL_ENCRYPTION=tls
